APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Set this to true when deployed behind HTTPS.
SESSION_SECURE_COOKIE=false

# Required for real card/mobile-money payments. Never commit this key.
# Also configure https://your-host/api/paystack/webhook in the Paystack dashboard.
PAYSTACK_SECRET_KEY=
# Set this to the Paystack rate in your contract, used for payout reporting.
PAYSTACK_FEE_PERCENTAGE=1.95

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Use smtp in production. "log" only records emails in storage/logs and does not deliver them.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Required for live SMS delivery. Failed requests appear in Admin > Logs.
# The key is on your Arkesel dashboard: sms.arkesel.com/user/sms-api/info
ARKESEL_SMS_API_KEY=
ARKESEL_SMS_SENDER_ID=OyaloWiFi
# true = try the local format (0244xxxxxx) first, then fall back to 233244xxxxxx.
ARKESEL_SMS_LOCAL_FORMAT=true

# IMPORTANT: voucher, expiry and announcement SMS are sent by the Laravel
# scheduler. The server MUST run this cron every minute for SMS to go out:
#   * * * * * php /path/to/your/app/artisan schedule:run >> /dev/null 2>&1

# An online router becomes offline after this many minutes without a heartbeat.
ROUTER_OFFLINE_AFTER_MINUTES=3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
